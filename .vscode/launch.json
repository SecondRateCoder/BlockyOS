{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Build-Suite",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/tools/build-suite/build.ps1",
            "args": [
                "-SHELLSCRIPT", "${file}"
            ],
        }, {
            "name": "Debug EXEC-Utils",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build EXEC Utils",
            "program": "${workspaceFolder}//tools//executable-format//exechandler.exe",
            "args": [
                "${workspaceFolder}\\tools\\filesystem\\fs.exe",
                "${workspaceFolder}\\tools\\output-1.exe", 
                "-d", "-D", "-L", "${workspaceFolder}\\tools\\output-1.log"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }, {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }, { 
                    "description": "Enable Back-Stepping",
                    "text": "-exec console \"record full\"",
                    "ignoreFailures": true
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }, {
            "name": "Debug FS-Utils",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build FS Utils",
            "program": "${workspaceFolder}//tools//filesystem//fs.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }, { 
                    "description": "Enable Back-Stepping",
                    "text": "record full",
                    "ignoreFailures": true
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }, {
            "name": "Debug run.ps1",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}\\compile\\run.ps1",
            "args": [
                "-extrafiles", "\\a0x2800",
                "-BroadImage",
                "-SectorNum", "2000",
                "-clear",
                "-Reserved", "1"
            ],
            "cwd": "${cwd}",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            }
        }, {
            "name": "(QEMU)Debug Kernel",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}\\compile\\intermid.ps1",
            "args": ["-run", "qemu", "-imagetype", "default"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "cwd": "${cwd}"
        }, {
            "name": "(bochs)Debug Kernel",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}\\compile\\intermid.ps1",
            "args": ["-run", "bochs", "-imagetype", "default"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "cwd": "${cwd}"
        }, {
            "name": "Debug F-Rat.exe",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "C/C++: gcc.exe build f-rat.c",
            "program": "${workspaceFolder}\\tools\\f-rat.exe",
            "args": [
                "${workspaceFolder}\\Build\\temp\\floppy.img",
                "textual.txt",
                ""
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}