{
    "tasks": [
        {
            "type": "shell",
            "label": "Prep Broad Image",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\intermid.ps1"
            ]
        },
        {
            "type": "process",
            "label": "gcc Build and Debug FAT file",
            "dependsOn": "Prep Broad Image",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\tools\\fat.c",
                "-o",
                "${cwd}\\tools\\fat.exe"
            ],
            "options": {
                "cwd": "${cwd}\\tools\\"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "process",
            "label": "gcc Build and Debug FrAT file",
            "dependsOn": "Prep Broad Image",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\tools\\frat.c",
                "-o",
                "${cwd}\\tools\\frat.exe"
            ],
            "options": {
                "cwd": "${cwd}\\tools\\"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "process",
            "label": "gcc Build and Debug FrAT file no floppy",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\tools\\frat.c",
                "-o",
                "${cwd}\\tools\\frat.exe"
            ],
            "options": {
                "cwd": "${cwd}\\tools\\"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}