{
    "tasks": [
        {
            "type": "shell",
            "label": "Prep Broad Image",
            "dependsOn": "Move cd",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\run.ps1",
                "-BroadImage",
                "-extraFiles", "${workspaceFolder}\\src\\public\\skibidi.txt",
                "-SectorNum", "10"
            ]
        },
        {
            "type": "process",
            "label": "gcc Build and Debug FAT file",
            "dependsOn": "Move cd",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\tools\\fat.c",
                "-o",
                "${cwd}\\tools\\fat.exe"
            ],
            "options": {
                "cwd": "${cwd}\\tools\\"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}