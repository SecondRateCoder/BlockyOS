{
    "tasks": [
        {
            "type": "shell",
            "label": "Build Utils",
            "dependsOn": [
                "Clear Terminal"
                // ,"Prep Broad Image"
            ],
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}//tools//filesystem//fs.ps1",
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel":"shared",
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }, {
            "type": "shell",
            "label": "Prep Broad Image",
            "dependsOn": "Clear Terminal",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}//compile//intermid.ps1",
                "-nocompile"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }, {
            "type": "shell",
            "label": "Clear Terminal",
            "command": "cls",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ],
    "version": "2.0.0"
}