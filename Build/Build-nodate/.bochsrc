
cpu: model=corei7_skylake_x, ips=50000000, count=2, reset_on_triple_fault=1, ignore_bad_msrs=1
boot: disk
megs: 4096
config_interface: win32config
display_library: sdl

magic_break: enabled=1

sound: driver=default
speaker: enabled=1, mode=sound
e1000: enabled=1
pci: enabled=1, chipset=i440fx, slot1=pcivga, slot2=e1000
vga: extension=vbe, update_freq=10, realtime=1, vbe_memsize=32
mouse: enabled=1
keyboard: type=mf, serial_delay=150, paste_delay=100000

magic_break: enabled=1
port_e9_hack: enabled=1, all_rings=1

log: C:\GitHub\BlockyOS\Build\Build-nodate\bochs.log
iodebug: all_rings=1
error: action=report
info: action=ignore
debug: action=ignore

romimage: file=C:\GitHub\BlockyOS\compile\toolchain\uefi\debug\OVMF_CODE.fd
vgaromimage: file=C:\msys64\mingw64\share\bochs\VGABIOS-lgpl-latest.bin
ata0: enabled=1, ioaddr1=0x1F0, ioaddr2=0x3F0, irq=14
ata0-master: type=disk, path="C:\GitHub\BlockyOS\Build\Build-nodate\disk.img", mode=flat, status=inserted, translation=lba

