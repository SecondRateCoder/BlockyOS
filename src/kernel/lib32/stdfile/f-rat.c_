// gcc -o f-rat.exe -g ./f-rat.c
#include "f-rat.h"

sectorbuff openFileNames[MAX_FHANDLES];
static stdfileENVIROMENT env;

int main(uint32_t argc, char **argv){
	enableAnsi();
	IMG_Setup(*(argv + 1));
	createFile(0, 100, "The 1st File", "rw0");
	openFile("The 1st File");
	ptrStep(10, 0);
	closeFile("The 1st File");
	return 1;
}

