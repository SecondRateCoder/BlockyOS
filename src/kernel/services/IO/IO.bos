{
	"LOG": "C:/GitHub/BlockyOS/Build/Build-nodate/IO.log", 
	"SCRIPT.VERSION": 999, 
	"FS.IMAGE": "C:/GitHub/BlockyOS/Build/Build-nodate/disk.img", 
	"FS.FORMAT": {
		"TARGET.PARTITION": "ROOT", 
		"TARGET.BLOCK.SIZE": 2048, 
		"TARGET.LOG.BLOCKS": 32, 
		"TARGET.VERSION": "1:0"
	}, 
	"INPUT": {
        "EXECUTABLE": [
            {
				"OUTPUT": "C:/GitHub/BlockyOS/Build/Build-nodate/root-part/services/LibIO.dll", 
				"CARGS": "-mno-sse -mno-sse2 -mno-mmx -mno-3dnow -msoft-float -fno-unwind-tables -fno-asynchronous-unwind-tables -mcmodel=small -fno-stack-protector -nostdinc -I C:/GitHub/BlockyOS/src -I C:/GitHub/BlockyOS/", 
				"LARGS": "--section-alignment 4096 --file-alignment 4096 -shared -flinker-output=dyn -Bsymbolic --out-implib C:/GitHub/BlockyOS/Build/Build-nodate/root-part/services/LibIO.dll.a", 
				"FILES": [
					"C:/GitHub/BlockyOS/src/kernel/services/IO/IO.c", 
					"C:/GitHub/BlockyOS/Build/Build-nodate/root-part/LibCrt.dll", 
					"C:/GitHub/BlockyOS/src/kernel/services/IO/IO.def"
				]
			}
        ]
    }
}

FSFRAT.MAKE -p "SYSD/" -n "LibIO.dll" -la "fc"
FSFRAT.OPEN -p "SYSD/LibIO.dll" -a "IO" -la "f"
FSFRAT.WRITE -pp "C:/GitHub/BlockyOS/Build/Build-nodate/root-part/services/LibIO.dll" -ia "%IO%" -p 0 -n 0