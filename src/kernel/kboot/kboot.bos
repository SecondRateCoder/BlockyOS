#FSFRAT.RUNTIME:ENABLED
#JSON:ENABLED
#CACHE:ENABLED

{
	"LOG": "C:/GitHub/BlockyOS/Build/Build-nodate/kboot.log", 
	"SCRIPT.VERSION": 999, 
	"FS.IMAGE": "C:/GitHub/BlockyOS/Build/Build-nodate/disk.img", 
	"FS.FORMAT": {
		"TARGET.PARTITION": "ROOT", 
		"TARGET.BLOCK.SIZE": 2048, 
		"TARGET.LOG.BLOCKS": 32, 
		"TARGET.VERSION": "1:0"
	}, 
	"INPUT": {
		"EXECUTABLE": [
			{
				"OUTPUT": "C:/GitHub/BlockyOS/Build/Build-nodate/root-part/kboot.exe", 
				"CARGS": "-mcmodel=small -fPIE -mno-sse -mno-sse2 -mno-mmx -mno-3dnow -msoft-float -I C:/GitHub/BlockyOS/src -I C:/GitHub/BlockyOS/ -I C:/GitHub/BlockyOS/compile/toolchain/gnu-efi-build/x86_64/include/efi/", 
				"LARGS": "--disable-runtime-pseudo-reloc --section-alignment 4096 --file-alignment 4096 -e kboot_km -pie --image-base 0x0 -Bsymbolic", 
				"FILES": [
					"C:/GitHub/BlockyOS/src/kernel/kboot/kboot.c", 
					"C:/GitHub/BlockyOS/src/kernel/kboot/kboot.asm", 
					"C:/GitHub/BlockyOS/Build/Build-nodate/root-part/LibCrt.dll", 
					"C:/GitHub/BlockyOS/Build/Build-nodate/root-part/services/LibIO.dll", 
					"C:/GitHub/BlockyOS/Build/Build-nodate/root-part/services/LibVideo.dll", 
				]
			}
		]
	}
}

FSFRAT.MAKE -p "SYSD/" -n "kboot.exe" -la "fc"
FSFRAT.OPEN -p "SYSD/kboot.exe" -a "KBOOT" -la "f"
FSFRAT.WRITE -pp "C:/GitHub/BlockyOS/Build/Build-nodate/root-part/kboot.exe" -ia "%KBOOT%" -p 0 -n 0