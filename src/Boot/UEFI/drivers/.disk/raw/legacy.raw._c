void *readblock(rawenv *re, UINTN pos, UINTN blocks){
    UINTN phys = re->B->Media->BlockSize;
    UINTN logicalBytes = re->configBlockSize * phys;
    UINTN totalBytes   = blocks * logicalBytes;
#ifdef __DEBUG__
    Print(
        L"\nRead [%a:%u: (%p)]: %llu; %llu",
        __FILE__, __LINE__, __builtin_return_address(1),
        pos, blocks
    );
#endif
    void *out = AllocatePool(totalBytes);
    if(!out){return NULL;}
    EFI_STATUS status = EFI_ERROR_MASK;
#ifdef __FRAT_USEPARTITION_PROTOCOL__
    // Disk I/O: offsets and sizes in BYTES
    for (UINTN cc = 0; cc < re->partitionpool.lpool; ++cc){
        if (re->MediaID == re->partitionpool.pool[cc].M->MediaId){
            status = uefi_call_wrapper(
                re->partitionpool.pool[cc].D->ReadDisk, 5,
                re->partitionpool.pool[cc].D,
                re->MediaID,
                pos * logicalBytes,   // byte offset
                totalBytes,           // byte size
                out
            );
            break;
        }
    }
#else
    // Block I/O: LBA + BufferSizeInBytes
    status = uefi_call_wrapper(
        re->B->ReadBlocks, 5,
        re->B,
        re->B->Media->MediaId,
        pos * re->configBlockSize, // starting LBA
        totalBytes,                // bytes, multiple of phys
        out
    );
#endif
#ifdef __DEBUG__
    Print(L"\nRead Output: %a", (EFI_ERROR(status) ? "FALSE" : "TRUE"));
#endif
    if(EFI_ERROR(status)){
        FreePool(out);
        return NULL;
    }
    return out;
}



BOOLEAN writeblock(rawenv *re, void *buffer, size_t pos, size_t blocks){
#ifdef __DEBUG__
	Print(
		L"\nWrite [%a:%u:	(%p)]: %llu; %llu", 
		__FILE__, __LINE__, __builtin_return_address(1),
		pos * re->configBlockSize, blocks * re->configBlockSize
	);
#endif
	EFI_STATUS status = EFI_ERROR_MASK;
#ifdef __FRAT_USEPARTITION_PROTOCOL__
	
	for(UINTN cc = 0; cc < re->partitionpool.lpool; ++cc){
		if(re->MediaID == re->partitionpool.pool[cc].M->MediaID){
			status = uefi_call_wrapper(
				re->partitionpool.pool[cc].D.WriteDisk, 5,
				re->partitionpool.pool[cc].D, re->MediaID, 
				pos * re->configBlockSize * re->B->Media->BlockSize, 
				blocks * re->configBlockSize * re->B->Media->BlockSize, 
				buffer
			);
		}
	}
#else
	status = uefi_call_wrapper(
		re->B->WriteBlocks, 5, re->B,
		re->B->Media->MediaId, pos * re->configBlockSize, blocks * re->configBlockSize, buffer
	);
#endif
#ifdef __DEBUG__
	Print(L"\nRead Output: %a", (EFI_ERROR(status) ? "FALSE": "TRUE" ));
	#ifdef __DEEP_DEBUG__
		Print(L"\n\n");
		for(
			UINTN cc = 0; 
			#ifdef __FRAT_USEPARTITION_PROTOCOL__
			cc < ((blocks * re->configBlockSize * re->B->Media->BlockSize) / sizeof(uint32_t)); 
			#else
			cc < (blocks * re->configBlockSize * re->B->Media->BlockSize);
			#endif
			++cc
		){
			Print(L"%08x ", ((uint32_t *)buffer)[cc]);
		}
		Print(L"\n\n");
	#endif
#endif
	return EFI_ERROR(status);
}

void dispose(rawenv *re){
#ifdef __DEBUG__
	if(re->EnableVerbose){Print(L"\nDisposing File Interface");}
#endif
	FreePool(re);
}