disk_read:
    params:
        ax(LBA): 20
        cl(Total sector count): 1
        [es:bx](The address to read to): [0:0x7e64]
    lbatochs:
        params:
            ax(LBA): 20
        return:
            ch(cylinder num): 0x14
            cl(sector num++): 0x03
            dh(head number): 0x00
    disk_read interrupt:
        params:
            ah(disk read instruction): 0x02
            al(number of sectors to read): 
            ch(cylinder number): 
            cl(sector number): 
            dh(head number): 
            dl(drive number): 
            [es:bx](Buffer to read to): 