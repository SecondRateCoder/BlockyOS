disk_read:
    params:
        ax(LBA): 0x0
        cl(Total sector count): 0x01
        [es:bx](The address to read to): [0:0x7e00]
    lbatochs:
        params:
            ax(LBA): 0x0
        return:
            ch(cylinder num): 0x00
            cl(sector num): 0x01
            dh(head number): 0x00
    disk_read interrupt:
        params:
            ah(disk read instruction): 0x02
            al(number of sectors to read): 0x01
            ch(cylinder number): 0x00
            cl(sector number): 0x01
            dh(head number): 0x00
            dl(drive number): 0x00
            [es:bx](Buffer to read to): [0xf000:0x7e00]